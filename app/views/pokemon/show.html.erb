<% content_for :title, @pokemon.display_name %>
<p><%= link_to "← Pokédex", root_path %></p>
<div class="row g-4">
  <section class="col-lg-7">
    <div class="catalog-card p-4">
      <p class="eyebrow">#<%= format("%03d", @pokemon.dex_number) %></p>
      <h1 class="pokemon-detail-name"><%= @pokemon.display_name %></h1>
      <%= image_tag "/sprites/#{@pokemon.dex_number}.png", alt: "", width: 272, height: 272,
        class: "pokemon-sprite pokemon-sprite-detail" %>
      <dl class="pokemon-stats mt-4 mb-0">
        <div class="pokemon-stat">
          <dt>Source identifier</dt>
          <dd><%= @pokemon.identifier %></dd>
        </div>
        <div class="pokemon-stat stat-height">
          <dt>Height</dt>
          <dd><%= @pokemon.height_dm / 10.0 %> m</dd>
        </div>
        <div class="pokemon-stat stat-weight">
          <dt>Weight</dt>
          <dd><%= @pokemon.weight_hg / 10.0 %> kg</dd>
        </div>
        <div class="pokemon-stat stat-experience">
          <dt>Base experience</dt>
          <dd><%= @pokemon.base_experience || "Unavailable" %></dd>
        </div>
      </dl>
    </div>
  </section>
  <section class="col-lg-5">
    <div class="catalog-card p-4 h-100">
      <h2 class="h4">Elemental types</h2>
      <ol class="mb-0 ps-4">
        <% @pokemon.pokemon_typings.each do |typing| %>
          <% type = typing.elemental_type %>
          <li><%= link_to type.display_name, elemental_type_path(type), class: "type-pill type-#{type.identifier}" %></li>
        <% end %>
      </ol>
    </div>
  </section>
</div>
