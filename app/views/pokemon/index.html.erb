<header class="dex-banner mb-4">
  <p class="dex-kicker">Kanto Field Guide · Vol. 01</p>
  <h1 class="display-4">Kanto Pokédex</h1>
  <p class="lead mb-0">From Bulbasaur to Mew. Find a familiar face or follow a type through all 151 entries.</p>
</header>

<%= form_with url: root_path, method: :get, class: "row g-3 align-items-end mb-4" do |form| %>
  <div class="col-md-5">
    <%= form.label :q, "Pokémon name", class: "form-label" %>
    <%= form.search_field :q, value: @query, placeholder: "e.g. Charizard", class: "form-control" %>
  </div>
  <div class="col-md-4">
    <%= form.label :elemental_type_id, "Type", class: "form-label" %>
    <%= form.collection_select :elemental_type_id, @types, :id, :display_name,
      { include_blank: "All types", selected: @type_id }, { class: "form-select" } %>
  </div>
  <div class="col-md-3 d-flex gap-2 align-items-center">
    <%= form.submit "Search", class: "btn btn-dark" %>
    <%= link_to "Clear", root_path, class: "btn btn-outline-dark" %>
  </div>
<% end %>

<p class="dex-results"><span>Field index</span><span><%= pluralize(@total, "result") %></span></p>
<% if @pokemon.any? %>
  <ul class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-2 g-sm-3 list-unstyled">
    <%= render partial: "pokemon/card", collection: @pokemon, as: :entry %>
  </ul>
  <%= render "pagination" if @page_count > 1 %>
<% else %>
  <p class="alert alert-light">No Pokémon match those filters.</p>
<% end %>
