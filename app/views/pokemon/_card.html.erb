<li class="col">
  <div class="dex-card h-100 type-<%= entry.elemental_types.first&.identifier %>">
    <div class="dex-card-art">
      <span class="dex-card-number">#<%= format("%03d", entry.dex_number) %></span>
      <%= image_tag "/sprites/#{entry.dex_number}.png", alt: "", width: 128, height: 128,
        loading: "lazy", class: "pokemon-sprite pokemon-sprite-card" %>
    </div>
    <div class="dex-card-body">
      <h2 class="pokemon-card-name"><%= link_to entry.display_name, pokemon_path(entry) %></h2>
      <% entry.elemental_types.each do |type| %>
        <%= link_to type.display_name, elemental_type_path(type), class: "type-pill type-#{type.identifier}" %>
      <% end %>
    </div>
  </div>
</li>
