<li class="col">
  <div class="catalog-card h-100 p-4">
    <p class="eyebrow mb-2">#<%= format("%03d", entry.dex_number) %></p>
    <h2 class="h4"><%= link_to entry.display_name, pokemon_path(entry) %></h2>
    <% entry.elemental_types.each do |type| %>
      <%= link_to type.display_name, elemental_type_path(type), class: "type-pill" %>
    <% end %>
  </div>
</li>
