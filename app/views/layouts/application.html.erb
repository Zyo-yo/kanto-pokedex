<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? "#{yield(:title)} | Kanto Pokédex" : "Kanto Pokédex" %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <%= stylesheet_link_tag "/pokedex.css" %>
  </head>
  <body>
    <header class="site-header">
      <nav class="container d-flex align-items-center flex-wrap gap-3 py-3" aria-label="Main navigation">
        <%= link_to "KANTO / POKÉDEX", root_path, class: "brand me-auto" %>
        <%= link_to "Pokémon", root_path %>
        <%= link_to "Types", elemental_types_path %>
        <%= link_to "About", about_path %>
      </nav>
    </header>
    <main class="container py-5">
      <%= yield %>
    </main>
  </body>
</html>
